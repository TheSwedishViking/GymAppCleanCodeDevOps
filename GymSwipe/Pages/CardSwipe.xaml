<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymSwipe.Pages.CardSwipe"
             Title="CardSwipe">
    <VerticalStackLayout>
        <!--<Image
            x:Name="ExampleCard"
            Source="sceptile_card.jpg"
            HeightRequest="300"
            WidthRequest="140"
            >
            <Image.GestureRecognizers>
                <PanGestureRecognizer/>
            </Image.GestureRecognizers>
        </Image>-->
        <Label FontSize="Large" Text="Card-Swipe Demo"/>
        <Label Text="{Binding CardDeckInfo}" />
        <Grid 
            x:Name="CardShell" 
            WidthRequest="{Binding CardWidth}"
            IsVisible="{Binding IsCardStructureVisible}"
            
            >
            <Border x:Name="Card" StrokeShape="RoundRectangle 16" Padding="16">
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="PanGestureRecognizer_PanUpdated"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout>
                    <Label FontSize="Large" Text="{Binding CurrentExercise.Name}"/>
                    <Label Text="Example Exercise"/>
                    <Label Text="{Binding CurrentExercise.Id}"/>
                    <Image  x:Name="CardImage" Source="{Binding CardImageSource}"/>
                    <Label Text="{Binding CurrentExercise.VideoSourceLink}" FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <CollectionView
           ItemsSource="{Binding AddedCards}">
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>