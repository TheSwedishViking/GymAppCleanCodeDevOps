<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymSwipe.Pages.UserRegistrationPage"
             Title="UserRegistrationPage">
    <Grid Margin="50,25,20,20" RowSpacing="50">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label 
            Text="Register as new user... 🫠"
            Grid.Row="0"
            Grid.Column="0"
            />
        <Label
            Text="Firstname" 
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            Grid.Row="1"
            Grid.Column="0"
            />
        <Entry
            x:Name="FirstNameEntry"
             Grid.Row="1"
            Grid.Column="1"/>
        <Label
            Text="Surname" 
            VerticalOptions="Center" 
            HorizontalOptions="Center"
             Grid.Row="2"
        Grid.Column="0"
            />
        <Entry
            x:Name="SurNameEntry"
             Grid.Row="2"
 Grid.Column="1"/>
    </Grid>

</ContentPage>