<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymSwipe.Pages.UserSignInPage"
             Title="UserSignInPage">

    <VerticalStackLayout Spacing="20" Margin="50,25,20,20">

        <Label
            Text="Sign in Page!!"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

        <Grid RowSpacing="20" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

     
            <Label
                Text="{Binding StatusCheck}"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalOptions="Center" />

            <Label
                Text="Email"
                Grid.Row="2"
                Grid.Column="0"
                VerticalOptions="Center" />
            <Entry
                x:Name="EmailEntry"
                Text="{Binding EmailEntry}"
                Keyboard="Email"
                Grid.Row="2"
                Grid.Column="1" />
        </Grid>

        <Button
            Text="Login!"
            Command="{Binding SignInCommand}" />

    </VerticalStackLayout>
</ContentPage>