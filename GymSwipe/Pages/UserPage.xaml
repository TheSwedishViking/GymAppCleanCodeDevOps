<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymSwipe.Pages.UserPage"
             Title="UserPage">
    <VerticalStackLayout>
        <Label 
            Text="User Registration Page!"
            FontSize="Large"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button
            Text="{Binding ButtonText}"
            Command="{Binding GreetUserCommand}"
            Clicked="OnClickGetUser"
            />
        <Label
            Text ="{Binding LblText.Name}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label
            Text ="{Binding LblText.Age, StringFormat='Years old: {0}'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label
            Text ="{Binding LblText.Height , StringFormat='cm: {0}'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label
            Text ="{Binding LblText.Athlete, StringFormat='Is athlete: {0}'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>