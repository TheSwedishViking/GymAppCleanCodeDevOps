<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymSwipe.Pages.UserPage"
             Title="UserPage">
    <VerticalStackLayout>
        <Label 
            Text="{Binding CurrentUser.Firstname, StringFormat='Hello {0} !'}" 
            FontSize="Large"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label
            Text ="{Binding CurrentUser.Surname ,StringFormat='Surname :  {0} !'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label
            Text ="{Binding CurrentUser.HeightCm , StringFormat=' {0} : cm'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label
            Text ="{Binding CurrentUser.WeightKg , StringFormat=' {0}   : KG'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label
            Text ="{Binding CurrentUser.Gender , StringFormat='Male ?  :  {0}'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label
            Text ="{Binding CurrentUser.FriendCode , StringFormat='FriendCode:    {0}'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button
        Text="{Binding ButtonText}"
        Command="{Binding GreetUserCommand}"
        Clicked="OnClickGreetUser"/>

        <Button
            Text="Delete"
            Command="{Binding DeleteUserCommand}"
            />

        <Label
            x:Name="lblGreeted"
            Text ="{Binding GreetingUser}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Grid ColumnDefinitions="Auto,Auto, Auto"
                ColumnSpacing="10"
                Padding="10,0"
                BackgroundColor="Grey">        
            
            <Label 
            Text = "{Binding CurrentUser.Firstname, StringFormat='{0}s Playlists '}"
            FontSize="Large"
            TextColor="White" Grid.Column="0"
            />
            <Button Text="Show Previous Three" WidthRequest="250" BackgroundColor="Green" Command="{Binding PreviousPageCommand}" 
            FontSize="20" BorderColor="Red" BorderWidth="2" FontAttributes="Bold" TextColor="White" Grid.Column="1"/>

            <Button Text="Show next three" WidthRequest="200" BackgroundColor="Purple" Command="{Binding NextPageCommand}"
                FontSize="20" BorderColor="Red" BorderWidth="2" FontAttributes="Bold" TextColor="White" Grid.Column="2"/>
  
        </Grid>













            
            <HorizontalStackLayout
                BindableLayout.ItemsSource="{Binding CurrentThreePlaylists}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout
                    WidthRequest="550"
                    Padding="10"
                    BackgroundColor="Black">

                            <Grid
                        ColumnDefinitions="auto,Auto"
                        RowDefinitions="Auto,Auto"
                        BackgroundColor="Green"
                        Padding="8">

                                <Label
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Name}"
                                    FontAttributes="Bold"
                                    FontSize="Medium"
                                    TextColor="Purple"
                                    BackgroundColor="Black"/>

                                <Label
                                    Grid.Column="0" Grid.Row="1" 
                                    Text="{Binding DateCreated}"
                                    Padding="5"
                                    HorizontalTextAlignment="Center"
                                    Background="BlanchedAlmond"
                                    FontFamily="Arial"
                                    FontAttributes="Bold"
                                    TextColor="Purple"
                                    FontSize="22"/> 

                                <Button Text="Play" Grid.Column="1" Grid.Row="1" />


                            </Grid>


                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Excercise}"
                                Spacing="4"
                                Margin="2"> 

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>

                                        <Grid
                                            ColumnDefinitions="Auto,Auto,2*,Auto"
                                            ColumnSpacing="10"
                                            Padding="10,0"
                                            BackgroundColor="Grey"> 

                                                <Label
                                                    Grid.Column="0"
                                                Text="{Binding PlaylistOrder}"/>

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding Exercise.Name}"
                                                FontAttributes="Bold"/>

                                            <FlexLayout
                                                        Grid.Column="2"
                                                        BindableLayout.ItemsSource="{Binding Exercise.TargetAreas}" Wrap="Wrap">                
                                                <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Label Text="{Binding Name}" Margin="0,0,4,0"/>
                                                        </DataTemplate>
                                                 </BindableLayout.ItemTemplate>

                                            </FlexLayout>

                                
                                        </Grid>

                                        
                                    </DataTemplate>
                                    
                                    
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>
                            

                        </VerticalStackLayout>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

    </HorizontalStackLayout>


    </VerticalStackLayout>
</ContentPage>