<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymSwipe.Pages.UserPage"
             x:Name="Page"
             Title="UserPage">
    <ScrollView>
        <VerticalStackLayout>
            <!---For user-->
            <Label 
            Text="{Binding CurrentUser.Firstname, StringFormat='Hello {0} !'}" 
            FontSize="Large"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <Label
            Text ="{Binding CurrentUser.Surname ,StringFormat='Surname :  {0} !'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <Label
            Text ="{Binding CurrentUser.HeightCm , StringFormat=' {0} : cm'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <Label
            Text ="{Binding CurrentUser.WeightKg , StringFormat=' {0}   : KG'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <Label
            Text ="{Binding CurrentUser.Gender , StringFormat='Is male?  :  {0}'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <Label
            Text ="{Binding CurrentUser.FriendCode , StringFormat='FriendCode:    {0}'}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <Label
            x:Name="lblGreeted"
            Text ="{Binding GreetingUser}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
            <!--Toolbar section-->

                <HorizontalStackLayout Spacing="10" Padding="10,0" BackgroundColor="LightSeaGreen">
                <Label Text="{Binding CurrentUser.Firstname, StringFormat='{0}s Playlists '}"
                       FontSize="Large" TextColor="White" VerticalOptions="Center"/>
                <Button Text="Show Previous Three" WidthRequest="250"
                        BackgroundColor="Green" Command="{Binding PreviousPageCommand}"
                        FontSize="20" BorderColor="Red" BorderWidth="2"
                        FontAttributes="Bold" TextColor="White"/>
                <Button Text="Show next three" WidthRequest="200"
                        BackgroundColor="Purple" Command="{Binding NextPageCommand}"
                        FontSize="20" BorderColor="Red" BorderWidth="2"
                        FontAttributes="Bold" TextColor="White"/>
            </HorizontalStackLayout>
            <!--Playlist section-->
            <HorizontalStackLayout
                BindableLayout.ItemsSource="{Binding CurrentThreePlaylists}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout
                             WidthRequest="550"
                            Padding="10"
                         >
                            
                            <VerticalStackLayout Spacing="4" BackgroundColor="DarkSeaGreen">
                                <Label
                                   Text ="{Binding Name }"
                                    FontAttributes="Bold"
                                    FontSize="Medium"
                                     TextColor="White"
                                    BackgroundColor="MediumVioletRed"/>
                                <Button Text="Play ▶️" 
                                        CornerRadius="0"
                               Command="{Binding BindingContext.PlayPlaylistCommand, Source={x:Reference Page}}"
                                 CommandParameter="{Binding .}"
                                 /> 
                          <HorizontalStackLayout Spacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <VerticalStackLayout.Resources>
                                            <Style x:Key="PlaylistInfoLabel" TargetType="Label">
                                                <Setter Property="Padding" Value="5,2"/>
                                                <Setter Property="HorizontalOptions" Value="Start"/>
                                                <Setter Property="HorizontalTextAlignment" Value="Start"/>
                                                <Setter Property="FontFamily" Value="Calibri"/>
                                                <Setter Property="FontAttributes" Value="Bold"/>
                                                <Setter Property="TextColor" Value="Purple"/>
                                                <Setter Property="FontSize" Value="18"/>
                                            </Style>
                                        </VerticalStackLayout.Resources>
                                        <Label Style="{StaticResource PlaylistInfoLabel}"
                                             Text="{Binding DateCreated, StringFormat='Created: {0}'}"/>
                                        <Label Style="{StaticResource PlaylistInfoLabel}"
                                              Text="{Binding LastPlayed, StringFormat='Last played: {0}'}"/>
                                        <Label Style="{StaticResource PlaylistInfoLabel}"
                                               Text="{Binding CaloriesBurnedFromLatestWorkout, StringFormat='Calories burnt from last time: {0}'}"/>
                                        <Label Style="{StaticResource PlaylistInfoLabel}"
                                                 Text="{Binding TimesPlayed, StringFormat='Times played: {0}'}"/>
                                        <Label Style="{StaticResource PlaylistInfoLabel}"
                                                  Text="{Binding LatestElapsedTime, StringFormat='Last recorded time: {0}'}"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <!--Exercise rows-->
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Excercise}"
                                Spacing="4"
                                Margin="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            ColumnDefinitions="Auto,Auto"
                                            ColumnSpacing="10"
                                            Padding="10,0"
                                            BackgroundColor="MediumVioletRed">
                                            <Label
                                                    Grid.Column="0"
                                                Text="{Binding PlaylistOrder}"/>
                                            <Label
                                                    Grid.Column="1"
                                                    Text="{Binding Name}"
                                                    FontAttributes="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>