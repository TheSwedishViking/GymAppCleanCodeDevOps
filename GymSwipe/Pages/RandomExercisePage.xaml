<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymSwipe.Pages.RandomExercisePage"
             Title="RandomExercisePage">

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">
        <Button Grid.Row="0"
                Text="Get random!"
                Command="{Binding GetRandomExcerises}"
                HorizontalOptions="Center" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ExerciseDTOs}"
                        ItemsLayout="VerticalList"
                        EmptyView="Nothing to show...">
            <CollectionView.Header>
                <VerticalStackLayout BackgroundColor="Bisque">
                    <Label Text="Random Exercises" FontSize="Large"/>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10" Padding="10">
                        <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="{Binding Id}" FontAttributes="Italic"/>
                        <Label Grid.Column="2" Text="{Binding VideoSourceLink}" FontAttributes="Italic"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>