name: 'Build and validate before merge ‼️🫠🤸‍♀️'
on:
  pull_request: 
    branches:
      - main
jobs:
  BuildJob:
    runs-on: ubuntu-latest
    env:
      net_v: '10.0.x0
    steps:
      - name: Checkout the repo 👀  
        uses: actions/checkout@v7

      - name: Setup .Net 🪻🟪
        uses: actions/setup-dotnet@v6
        with:
          dotnet-version: ${{env.net_v}}
          
      - name: Build 🛠️ 
        run: |
          echo "Building!"
          dotnet build --no-restore --configuration Release
      - name: Run Tests 📈📉
        run: |
          echo "Running tests"
          dotnet test --no-build --configuration Release
